{
  "name": "agenda-familiar",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "test:rules": "firebase emulators:exec --only firestore --project demo-agenda-familiar \"npm --prefix firestore-tests test\"",
    "test:loading": "node --experimental-strip-types --test tests/loading.test.cjs",
    "test": "node --experimental-strip-types --test tests/*.test.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~2.2.0",
    "expo": "^58.0.21",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
