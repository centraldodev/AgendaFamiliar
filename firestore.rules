rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function member(familyId) {
      return signedIn() && familyId is string && familyId.size() > 0
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('familyId', null) == familyId;
    }
    function admin(familyId) {
      return member(familyId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }
    function taskOwner(data) { return signedIn() && data.createdBy == request.auth.uid; }
    function readableTask(data) {
      return member(data.familyId)
        && (data.isPrivate == false || taskOwner(data));
    }
    function basicTask(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 4000
        && data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.dueTime == null || (data.dueTime is string && data.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.isPrivate is bool;
    }
    function dateString(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validRecurrence(data) {
      return data.get('recurrence', 'none') in
          ['none', 'daily', 'weekly', 'custom_weekly', 'interval', 'monthly', 'yearly']
        && (data.get('recurrenceInterval', null) == null
          || (data.recurrenceInterval is int && data.recurrenceInterval >= 1 && data.recurrenceInterval <= 365))
        && (data.get('recurrence', 'none') != 'interval' || data.get('recurrenceInterval', null) is int)
        && (data.get('weekDays', null) == null || (data.weekDays is list && data.weekDays.size() <= 7))
        && (data.get('recurrence', 'none') != 'custom_weekly'
          || (data.get('weekDays', null) is list && data.weekDays.size() > 0))
        && (data.get('recurrenceEndDate', null) == null || dateString(data.recurrenceEndDate));
    }
    function validSubtasks(data) {
      return data.get('subtasks', []) is list && data.get('subtasks', []).size() <= 30;
    }
    // Responsável: ninguém, ou um membro da mesma família; tarefa privada não tem.
    function validAssignee(data) {
      return data.get('assignedTo', null) == null
        || (data.assignedTo is string && data.isPrivate == false
          && get(/databases/$(database)/documents/users/$(data.assignedTo)).data.get('familyId', null) == data.familyId);
    }
    function taskAssignee(data) { return signedIn() && data.get('assignedTo', null) == request.auth.uid; }
    function writeMetadata(data) {
      return data.lastModifiedBy == request.auth.uid && data.updatedAt == request.time;
    }

    match /users/{uid} {
      // O perfil contém dados pessoais. Apenas seu titular pode lê-lo.
      allow get: if self(uid);
      allow list: if false;
      allow create: if self(uid)
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120;
      // Vínculo familiar e papel são definidos exclusivamente pelo backend.
      // Nome e preferência de lembrete (minutos antes; -1 = desligado).
      allow update: if self(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'reminderMinutes'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.get('reminderMinutes', 0) in [-1, 0, 15, 30, 60, 120, 1440];
      allow delete: if false;
    }

    match /families/{familyId} {
      allow get: if member(familyId);
      allow list, create, update, delete: if false;
      // Criação e entrada por código passam pela Cloud Function autenticada.
    }

    match /tasks/{taskId} {
      allow read: if readableTask(resource.data);
      allow create: if member(request.resource.data.familyId)
        && request.resource.data.keys().hasAll([
          'title', 'description', 'dueDate', 'dueTime', 'category', 'isPrivate',
          'familyId', 'createdBy', 'createdAt', 'updatedAt',
          'lastModifiedBy', 'completed', 'recurrence', 'subtasks'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'dueDate', 'dueTime', 'category', 'isPrivate',
          'familyId', 'createdBy', 'createdAt', 'updatedAt',
          'lastModifiedBy', 'completed', 'recurrence', 'subtasks',
          'weekDays', 'recurrenceInterval', 'recurrenceEndDate', 'assignedTo'
        ])
        && taskOwner(request.resource.data)
        // Usuários comuns só criam tarefas públicas; privadas são de administradores.
        && (request.resource.data.isPrivate == false || admin(request.resource.data.familyId))
        && request.resource.data.createdAt == request.time
        && writeMetadata(request.resource.data)
        && basicTask(request.resource.data)
        && request.resource.data.completed == false
        && validRecurrence(request.resource.data)
        && validSubtasks(request.resource.data)
        && validAssignee(request.resource.data);

      // IDs, autoria e família permanecem imutáveis.
      allow update: if member(resource.data.familyId)
        && writeMetadata(request.resource.data)
        && (
          // Concluir tarefa pendente: o criador ou o responsável; admin nas compartilhadas.
          // Subtarefas são marcadas pelo backend (agendaTaskOccurrence, action "toggleSubtask").
          // Recorrentes são concluídas pelo backend, que arquiva e cria a próxima.
          ((taskOwner(resource.data) || taskAssignee(resource.data)
              || (resource.data.isPrivate == false && admin(resource.data.familyId)))
            && resource.data.get('completed', false) == false
            && resource.data.get('skipped', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed', 'lastModifiedBy', 'updatedAt'])
            && request.resource.data.completed is bool
            && (request.resource.data.completed == false
              || resource.data.get('recurrence', 'none') == 'none')
            )
          // Restaurar uma concluída ou pulada: somente admin, na própria tarefa ou nas compartilhadas.
          || (admin(resource.data.familyId)
            && (taskOwner(resource.data) || resource.data.isPrivate == false)
            && (resource.data.get('completed', false) == true || resource.data.get('skipped', false) == true)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed', 'skipped', 'lastModifiedBy', 'updatedAt'])
            && request.resource.data.completed == false
            && request.resource.data.get('skipped', false) == false)
          // Editar detalhes: somente admin, na própria tarefa ou nas compartilhadas
          // (nunca torna privada a tarefa de outra pessoa).
          || (admin(resource.data.familyId)
            && (taskOwner(resource.data)
              || (resource.data.isPrivate == false && request.resource.data.isPrivate == false))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'description', 'dueDate', 'dueTime', 'category', 'isPrivate',
              'completed', 'lastModifiedBy', 'updatedAt', 'subtasks',
              'recurrence', 'weekDays', 'recurrenceInterval', 'recurrenceEndDate', 'assignedTo'
            ])
            && basicTask(request.resource.data)
            && validAssignee(request.resource.data)
            && validRecurrence(request.resource.data)
            && validSubtasks(request.resource.data)
            && request.resource.data.completed is bool)
        );
      // Somente admin exclui; tarefas privadas só pelo próprio criador.
      allow delete: if admin(resource.data.familyId)
        && (resource.data.isPrivate == false || taskOwner(resource.data));
    }

    // Categorias da família (formato do app anterior). Qualquer membro cria;
    // ninguém altera ou exclui pelo app.
    match /categories/{categoryId} {
      allow read: if member(resource.data.familyId);
      allow create: if member(request.resource.data.familyId)
        && request.resource.data.keys().hasOnly([
          'label', 'icon', 'color', 'familyId', 'isDefault', 'createdBy', 'createdAt'
        ])
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 40
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 60
        && request.resource.data.color is string
        && request.resource.data.color.size() <= 20
        && request.resource.data.isDefault == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Funcionalidades antigas não utilizadas pelo aplicativo atual ficam fechadas.
    match /{document=**} { allow read, write: if false; }
  }
}
